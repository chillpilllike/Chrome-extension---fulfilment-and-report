<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="alternative_quotation_email" model="mail.template">
    <field name="name">After-order: alternative price difference</field>
    <field name="model_id" ref="sale.model_sale_order"/>
    <field name="subject">{{ object.after_order_parent_id.name }} — payment for your selected alternative</field>
    <field name="email_to">{{ object.partner_id.email or '' }}</field>
    <field name="lang">{{ object.partner_id.lang }}</field>
    <field name="auto_delete" eval="False"/>
    <field name="body_html" type="html">
      <t t-set="preview" t-value="object.env.context.get('care_email_preview',False)"/>
      <t t-set="care_order" t-value="object if preview else object.after_order_parent_id"/>
      <t t-set="care_product" t-value="object.env['product.product'].browse(object.env.context.get('care_preview_product_id')) if preview else object.after_order_selected_product_id"/>
      <div style="margin:0;background:#ffffff;padding:32px 12px;font-family:Inter,Arial,sans-serif;color:#24372e">
        <table role="presentation" width="100%" style="max-width:600px;margin:0 auto" cellpadding="0" cellspacing="0">
          <tr><td style="padding:0 12px 24px">
            <img t-att-src="'%s/web/image/website/%s/logo' % (object.website_id.domain.rstrip('/'),object.website_id.id)" t-att-alt="object.website_id.name" style="max-width:170px;max-height:56px"/>
          </td></tr>
          <tr><td bgcolor="#f5f5f5" style="background:#f5f5f5;border:1px solid #e0e0e0;border-radius:0;padding:32px">
            <p t-if="preview" style="padding:12px;background:#eeeeee;font-weight:bold">TEST PREVIEW ONLY — no payment is due and no quotation was created.</p>
            <p style="font-size:12px;letter-spacing:2px;color:#64756a">YOUR SELECTED ALTERNATIVE</p>
            <h1 style="font-size:30px;line-height:1.2;font-weight:600;margin:16px 0">One more step for your order.</h1>
            <p style="font-size:15px;line-height:1.7">Your 24-hour selection window has ended. Your chosen alternative costs more than the original item. Please pay the difference below so we can continue processing your order.</p>
            <table t-if="care_product" role="presentation" width="100%" cellpadding="12" bgcolor="#eeeeee"><tr>
              <td width="80"><img t-att-src="'%s/web/image/product.product/%s/image_256' % (object.website_id.domain.rstrip('/'),care_product.id)" width="80" height="80" style="object-fit:contain" t-att-alt="care_product.display_name"/></td>
              <td><strong t-out="care_product.display_name"/><br/><a t-att-href="object.website_id.domain.rstrip('/') + care_product.website_url" target="_blank" rel="noopener noreferrer">View full product details</a></td>
            </tr></table>
            <table role="presentation" width="100%" bgcolor="#eeeeee" style="background:#eeeeee;border-radius:0;margin:24px 0" cellpadding="20"><tr><td>
              <span style="font-size:13px;color:#64756a">Order <t t-out="care_order.name"/></span><br/>
              <strong style="font-size:26px"><t t-out="format_amount(10 if preview else object.amount_total,object.currency_id)"/></strong><br/>
              <span t-if="preview" style="font-size:13px">Example amount for layout testing only</span>
              <span t-else="" style="font-size:13px">Additional payment · quotation <t t-out="object.name"/></span>
            </td></tr></table>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="background:#183e2c;border-radius:0">
              <a t-att-href="object.website_id.domain.rstrip('/') + ('/my/orders/%s' % object.id if preview else object.get_portal_url())" style="display:block;padding:16px 20px;color:white;font-size:15px;font-weight:600;text-decoration:none"><t t-if="preview">View order · test preview</t><t t-else="">View quotation &amp; pay securely</t></a>
            </td></tr></table>
            <p style="font-size:13px;line-height:1.7;color:#64756a;margin-top:24px">Payment is made on our website. If you need help with this quotation, please contact our team.</p>
          </td></tr>
          <tr><td style="text-align:center;padding:24px 16px;font-size:12px;line-height:1.7;color:#64756a">This message relates to order <t t-out="care_order.name"/> placed on <t t-out="object.website_id.name"/>.</td></tr>
        </table>
      </div>
    </field>
  </record>
</odoo>
