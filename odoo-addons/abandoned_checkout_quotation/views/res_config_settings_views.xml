<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="abandoned_quotation_review_form" model="ir.ui.view">
        <field name="name">abandoned.quotation.review.form</field>
        <field name="model">abandoned.quotation.review</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="website_id"/>
                    <field name="from_date"/>
                    <field name="reviewed_from_date" invisible="1"/>
                </group>
                <p>Find unpaid website quotations created before this addon was installed.</p>
                <field name="result" nolabel="1" invisible="not result"/>
                <field name="order_ids" nolabel="1"
                       invisible="not order_ids or from_date != reviewed_from_date">
                    <list create="0" edit="0" delete="0" open_form_view="0">
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="create_date"/>
                        <field name="amount_total"/>
                        <field name="currency_id" column_invisible="True"/>
                    </list>
                </field>
                <footer>
                    <button name="action_preview" type="object" string="Check quotations" class="btn-primary"/>
                    <button name="action_queue" type="object" string="Queue emails"
                            invisible="not order_ids or from_date != reviewed_from_date"
                            confirm="Queue the quotation emails shown above?"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="res_config_settings_view_form_inherit_abandoned_checkout_quotation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.abandoned.checkout.quotation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="abandoned_carts_setting" position="after">
                <setting id="abandoned_checkout_quotation_setting"
                         help="Email unpaid website quotations once, after six hours of inactivity. Applies to orders created after installation on this website.">
                    <field name="abandoned_quotation_enabled"/>
                    <div class="content-group mt8">
                        <button name="action_review_abandoned_quotations" type="object"
                                string="Review older quotations" class="btn-link" icon="oi-arrow-right"/>
                    </div>
                </setting>
            </setting>
            <setting id="abandoned_carts_setting" position="attributes">
                <attribute name="invisible">abandoned_quotation_enabled</attribute>
            </setting>
        </field>
    </record>
</odoo>
