{
  "manifest_version": 3,
  "name": "Nutricity Amazon Invoice Uploader",
  "description": "Downloads Amazon printable invoice PDFs, renames them by Odoo order, and uploads them to the fulfilment app.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.amazon.com/*",
    "https://amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nutricity Amazon Invoices",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/your-orders/*",
        "https://www.amazon.com/gp/css/*",
        "https://www.amazon.com/documents/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "amazon-invoice@nutricity.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
