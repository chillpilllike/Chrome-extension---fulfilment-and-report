<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_website_form_final_mile_tracking" model="ir.ui.view">
    <field name="name">website.form.final.mile.tracking</field>
    <field name="model">website</field>
    <field name="inherit_id" ref="website.view_website_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <group string="Final Mile Tracking">
          <field name="final_mile_tracking_enabled"/>
          <field name="final_mile_tracking_app_url"/>
          <field name="final_mile_tracking_slug"/>
          <field name="final_mile_tracking_store_id"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
