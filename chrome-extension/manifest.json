{
  "manifest_version": 3,
  "name": "Nutricity Amazon Fulfilment Engine",
  "description": "Queues Chrome-based Amazon fulfilment jobs from the local Nutricity control panel.",
  "version": "0.1.140",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://www.amazon.com/*",
    "https://amazon.com/*",
    "https://*.amazon.com/*"
  ],
  "action": {
    "default_title": "Nutricity Fulfilment",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://amazon.com/*",
        "https://*.amazon.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
