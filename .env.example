APP_SECRET_KEY=change-this-local-secret
ADMIN_ACCESS_TOKEN=change-this-admin-code
MASTER_ADMIN_ACCESS_TOKEN=1284
PUBLIC_ACCESS_CODE=change-this-public-code
POSTGRES_URL=postgres://user:password@host:5432/database
POSTGRES_POOL_MAX=10

# Optional search index
TYPESENSE_URL=
TYPESENSE_API_KEY=
TYPESENSE_ENABLED=false

# Optional currency conversion
OPENEXCHANGE_API_KEY=
OPENEXCHANGE_SYNC_INTERVAL_MINUTES=2880

# Cloudflare R2 / S3-compatible storage. Required for exports, reports, and invoices.
STORAGE_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com/bucket-name
STORAGE_S3_BUCKET=bucket-name
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Amazon Business API
AMAZON_API_BASE_URL=https://na.business-api.amazon.com
AMAZON_TRACKING_API_BASE_URL=https://na.business-api.amazon.com
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_API_ACCESS_TOKEN=

# These paths are configurable because Amazon Business API paths can differ by
# enabled region/version. The app stores payloads and responses either way.
AMAZON_PRODUCT_SEARCH_PATH=/products/2020-08-26/products
AMAZON_ORDER_CREATE_PATH=/ordering/2022-10-30/orders
AMAZON_ORDER_DETAILS_PATH=/ordering/2022-10-30/orders/{amazon_order_id}
AMAZON_PACKAGE_TRACKING_PATH=/ab-tracking/2025-07-02/orders/{orderId}/shipments/{shipmentId}/packages/{packageId}

# Optional browser URL pattern for direct Amazon Business order links.
AMAZON_ORDER_URL_TEMPLATE=https://www.amazon.com/gp/css/order-details?orderID={amazon_order_id}

# Optional Odoo dispatch behavior
ODOO_VALIDATE_PICKINGS=true

# After-order customer email. Keep test mode on until every website sender
# domain, public HTTPS URL, and template has been verified.
AFTER_ORDER_EMAIL_TEST_MODE=true
AFTER_ORDER_TEST_RECIPIENT=sonianuj1284@gmail.com
AFTER_ORDER_PUBLIC_BASE_URL=https://app.example.com
AFTER_ORDER_CUTOFF_DATE=2026-08-01
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@example.com
EMAIL_FROM_NAME=Customer Care
